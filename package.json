{
  "name": "@projectreshare/platform-rs",
  "version": "1.18.0",
  "description": "Top-level platform for ReShare UI",
  "license": "Apache-2.0",
  "repository": "openlibraryenvironment/platform-rs",
  "publishConfig": {
    "registry": "https://repository.folio.org/repository/npm-folio/"
  },
  "scripts": {
    "build": "export STRIPES_TRANSPILE_TOKENS=\"@k-int @projectreshare\"; export NODE_OPTIONS=\"--max-old-space-size=4096 $NODE_OPTIONS\"; stripes build stripes.config.js",
    "stripes": "stripes",
    "start": "stripes serve stripes.config.js",
    "cypress": "cypress",
    "build-module-descriptors": "node ./build-module-descriptors.js",
    "local": "f=stripes.config.js; test -f $f.local && f=$f.local; echo Using config $f; stripes serve $f",
    "start-local-diku": " set STRIPES_TRANSPILE_TOKENS=\"@k-int @projectreshare\" && stripes serve ./stripes.config.js --okapi=http://localhost:9130 --tenant=diku"
  },
  "dependencies": {
    "@folio/checkin": "11.0.3",
    "@folio/checkout": "12.0.2",
    "@folio/circulation": "11.0.4",
    "@folio/circulation-log": "6.0.2",
    "@folio/developer": "10.0.2",
    "@folio/inventory": "13.0.12",
    "@folio/requests": "12.0.4",
    "@folio/service-interaction": "4.0.0",
    "@folio/stripes": "10.0.22",
    "@folio/stripes-inventory-components": "2.0.9",
    "@folio/stripes-marc-components": "2.0.2",
    "@folio/tenant-settings": "10.0.0",
    "@folio/users": "12.1.16",
    "@projectreshare/directory": "https://github.com/openlibraryenvironment/ui-directory.git#release-1.13.x",
    "@projectreshare/plugin-rs-siquery-metaproxy": "0.1.3",
    "@projectreshare/request": "1.6.6",
    "@projectreshare/rs": "https://github.com/openlibraryenvironment/ui-rs.git#release-1.19.x",
    "@projectreshare/supply": "1.6.6",
    "@projectreshare/update": "^1.8.0",
    "inflected": "^2.0.4",
    "moment": "~2.29.0",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "react-intl": "^7.1.10",
    "react-query": "^3.13.0",
    "react-redux": "^8.0.5",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "redux": "^4.2.1",
    "rrule": "2.6.4"
  },
  "resolutions": {
    "@typescript-eslint/typescript-estree": "^6.2.1",
    "@rehooks/local-storage": "2.4.4",
    "@apollo/client": "3.13.9",
    "favicons": "7.1.4",
    "postcss-nesting": "^10.0.0",
    "downshift": "9.0.13",
    "@k-int/stripes-kint-components": "5.25.3",
    "@projectreshare/rs": "https://github.com/openlibraryenvironment/ui-rs.git#release-1.19.x",
    "@projectreshare/stripes-reshare": "2.1.0"
  },
  "devDependencies": {
    "@folio/stripes-cli": "~4.0.0"
  }
}
